---
/**
 * Uma linha da lista de projetos.
 *
 * Com case study, a linha liga à página: o link da ação estende-se por cima da
 * linha inteira. Sem case study, o título é um botão que abre a modal, também
 * estendido; a ação da direita é o repositório e fica por cima dele.
 *
 * Fase 4.2d: a etiqueta passou para baixo do título; a linha tem um id estável
 * (projeto-<slug>), igual nas duas línguas, para as provas das competências
 * poderem ligar a ela; e os projetos com `nota` mostram um botão "?" ao lado da
 * etiqueta, que abre esse texto por baixo.
 */
import type { CollectionEntry } from 'astro:content';
import { t, type Lang, type Ui } from '../i18n';
import { caseStudyHref } from '../lib/caseStudy';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  ui: Ui;
}

const { project, lang, ui } = Astro.props;
const p = project.data;

const caseHref = p.caseStudy ? caseStudyHref(p.slug, lang) : null;
const numero = String(p.order).padStart(2, '0');
const idNota = `nota-${p.slug}`;
---

<li id={`projeto-${p.slug}`} class="project-row reveal" data-project={p.slug}>
  {/* Decorativo: a posição na lista já é anunciada pelo leitor de ecrã. */}
  <span class="project-num" aria-hidden="true">{numero}</span>

  <div class="project-head">
    <h3 class="project-title">
      {
        caseHref ? (
          t(p.title, lang)
        ) : (
          <button type="button" class="project-open" data-modal={`modal-${p.slug}`} aria-haspopup="dialog">
            {t(p.title, lang)}
          </button>
        )
      }
    </h3>
    {
      (p.tagline || p.nota) && (
        <div class="project-meta">
          {p.tagline && <span class="project-tagline">{t(p.tagline, lang)}</span>}
          {p.nota && (
            <button
              type="button"
              class="info-btn"
              aria-label={ui['a11y-more-info']}
              aria-expanded="false"
              aria-controls={idNota}
            >
              <span aria-hidden="true">?</span>
            </button>
          )}
        </div>
      )
    }
    {
      p.nota && (
        <p id={idNota} class="info-balao" hidden>
          {ui[p.nota]}
        </p>
      )
    }
  </div>

  {/* Uma frase: o resto vive no case study (ou na modal, nos que não o têm). */}
  <p class="project-desc">{t(p.resumo, lang)}</p>

  <ul class="project-stack">
    {p.tech.map((tech) => <li class="project-tech">{t(tech, lang)}</li>)}
  </ul>

  <div class="project-action">
    {
      caseHref ? (
        <a class="project-action-link project-case-link" href={caseHref}>
          {ui['project-btn-case-study']}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      ) : (
        p.repoUrl && (
          <a
            class="project-action-link project-repo-link"
            href={p.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {ui['modal-btn-repo']}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        )
      )
    }
    {/* Rótulo inerte, sem href (hoje só o Licas): não há nada público para abrir. */}
    {
      p.status === 'in-development' && (
        <span class="project-status-disabled" aria-disabled="true">
          {ui['project-status-in-development']}
        </span>
      )
    }
  </div>
</li>

