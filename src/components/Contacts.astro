---
/**
 * Contactos, como lista de informação (fase 4).
 *
 * O email fica visível e ao lado vai um botão que o copia: um mailto: num
 * computador sem cliente de email configurado não faz nada. O comportamento
 * está em src/scripts/main.js; a mensagem de confirmação vem de data-feito.
 */
import type { Ui } from '../i18n';
import site from '../data/site.json';

interface Props {
  ui: Ui;
}

const { ui } = Astro.props;
---

<section id="contacts" class="contacts-section">
  <h2 class="section-heading reveal">{ui['contacts-heading']}</h2>
  <p class="contacts-text reveal">{ui['contacts-text']}</p>

  <dl class="contact-list reveal">
    <div class="contact-item">
      <dt class="contact-title">{ui['contact-title-email']}</dt>
      <dd class="contact-value-row">
        <a href={`mailto:${site.email}`} class="contact-value">{site.email}</a>
        <button
          type="button"
          class="copy-email"
          data-email={site.email}
          data-feito={ui['contact-copy-done']}>{ui['contact-btn-copy-email']}</button
        >
        <span class="copy-status" role="status" aria-live="polite"></span>
      </dd>
    </div>

    <div class="contact-item">
      <dt class="contact-title">{ui['contact-title-linkedin']}</dt>
      <dd class="contact-value-row">
        <a href={site.linkedinUrl} target="_blank" rel="noopener noreferrer" class="contact-value"
          >{site.linkedinHandle}</a
        >
      </dd>
    </div>

    <div class="contact-item">
      <dt class="contact-title">{ui['contact-title-github']}</dt>
      <dd class="contact-value-row">
        <a href={site.githubUrl} target="_blank" rel="noopener noreferrer" class="contact-value"
          >{site.githubHandle}</a
        >
      </dd>
    </div>
  </dl>
</section>
