---
import type { Ui } from '../i18n';
import SectionHeading from './SectionHeading.astro';

interface Props {
  ui: Ui;
}

const { ui } = Astro.props;

// Percurso, em dois parágrafos (fase 4.2d). Não descreve projetos: isso vive nas
// linhas de projeto e nos case studies.
const paragrafos = ['about-p1', 'about-p2'] as const;
---

<section id="about" class="about-section">
  <SectionHeading titulo={ui['about-heading']} />
  <div class="about-content reveal">
    {paragrafos.map((chave) => <p>{ui[chave]}</p>)}
  </div>
</section>

