---
/**
 * Imagem de um projeto, no cartão ou na modal.
 *
 * Deixou de haver dois modelos de imagem: as fotografias de stock do Unsplash
 * saíram e todos os projetos passam a apontar para um ficheiro em assets/images/.
 * Se o ficheiro não existir, o build falha — é intencional.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>['data'];
  variant: 'card' | 'modal';
  alt: string;
  class?: string;
}

const { project, variant, alt, class: className } = Astro.props;

// O cartão mostra no máximo ~450px de largura e a modal ~800px. Pedimos o dobro
// para ecrãs de alta densidade, sem nunca ampliar acima da origem.
const LARGURA_ALVO = { card: 900, modal: 1400 } as const;
const largura = Math.min(LARGURA_ALVO[variant], project.image.width);
---

<Image
  src={project.image}
  alt={alt}
  class={className}
  width={largura}
  loading="lazy"
  decoding="async"
/>
