---
/**
 * Imagem de um projeto, no cartão ou na modal.
 *
 * Nem todos os projetos têm screenshot. Quando falta, em vez de um espaço vazio
 * ou de uma imagem partida, desenha-se um bloco com as cores do site: as iniciais
 * do projeto sobre um gradiente com o roxo de acento. Ocupa exatamente a mesma
 * caixa que uma imagem real, para a grelha não mexer.
 *
 * As tecnologias ficam de fora: no cartão já aparecem nas badges logo abaixo, e
 * repeti-las aqui era ler a mesma lista duas vezes com 100px de intervalo.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n';

interface Props {
  project: CollectionEntry<'projects'>['data'];
  variant: 'card' | 'modal';
  lang: Lang;
  alt?: string;
  class?: string;
}

const { project, variant, lang, alt, class: className } = Astro.props;

// O cartão mostra no máximo ~450px de largura e a modal ~800px. Pedimos o dobro
// para ecrãs de alta densidade, sem nunca ampliar acima da origem.
const LARGURA_ALVO = { card: 900, modal: 1400 } as const;

/**
 * Iniciais a partir do nome curto do projeto — a parte antes do travessão.
 * "Licas — Plataforma..." -> L | "3D Analyzer — Motor..." -> 3A
 */
function iniciais(titulo: string) {
  const curto = titulo.split('—')[0].trim();
  const palavras = curto.split(/\s+/).filter(Boolean);
  return palavras
    .slice(0, 2)
    .map((p) => p[0])
    .join('')
    .toUpperCase();
}
---

{
  project.image ? (
    <Image
      src={project.image}
      alt={alt ?? ''}
      class={className}
      width={Math.min(LARGURA_ALVO[variant], project.image.width)}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div class:list={['project-fallback', className]} role="img" aria-label={t(project.title, lang)}>
      <span class="project-fallback-initials" aria-hidden="true">
        {iniciais(t(project.title, lang))}
      </span>
    </div>
  )
}
