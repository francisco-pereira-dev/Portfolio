---
/**
 * Ícone SVG inline.
 *
 * Substitui a fonte Devicon, que custava 126,6 KB de CSS e 11,7 MB de ficheiros
 * de fonte (sem WOFF2, com font-display: block) para desenhar 15 glifos.
 *
 * Os SVGs em src/icons/ são os oficiais do Devicon (licença MIT), com as
 * cores de marca substituídas por currentColor: a fonte renderizava monocromático,
 * herdando a propriedade `color`, e é essa a aparência a preservar.
 *
 * O dimensionamento continua a vir do `font-size` do contexto, via `width: 1em`
 * no CSS, para que as regras .skill-icon, .overlay-social-icon e
 * .contact-icon-circle continuem a mandar sem alterações de valor.
 */
const ficheiros = import.meta.glob<string>('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;

const chave = `../icons/${name}.svg`;
const bruto = ficheiros[chave];

if (!bruto) {
  const disponiveis = Object.keys(ficheiros)
    .map((c) => c.replace('../icons/', '').replace('.svg', ''))
    .sort()
    .join(', ');
  throw new Error(
    `Icon: não existe src/icons/${name}.svg. Disponíveis: ${disponiveis}`
  );
}

const classes = ['icon', className].filter(Boolean).join(' ');
// Decorativo: o texto ao lado (ou o aria-label do elemento pai) já nomeia o ícone.
const svg = bruto.replace(
  '<svg',
  `<svg class="${classes}" aria-hidden="true" focusable="false"`
);
---

<Fragment set:html={svg} />
