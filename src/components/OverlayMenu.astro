---
import type { Ui } from '../i18n';
import site from '../data/site.json';

interface Props {
  ui: Ui;
}

const { ui } = Astro.props;

const links = [
  { href: '#about', label: ui['overlay-about'] },
  { href: '#skills', label: ui['overlay-skills'] },
  { href: '#projects', label: ui['overlay-projects'] },
  { href: '#contacts', label: ui['overlay-contacts'] },
];
---

<div id="overlay-menu" class="overlay-menu">
  <div class="overlay-content reveal">
    <ul class="overlay-links">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="overlay-link">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="overlay-footer">
      <a
        href={site.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="overlay-social-icon"
        aria-label={ui['a11y-social-linkedin']}
      >
        <i class="devicon-linkedin-plain"></i>
      </a>
      <a
        href={site.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="overlay-social-icon"
        aria-label={ui['a11y-social-github']}
      >
        <i class="devicon-github-original"></i>
      </a>
      <a href={`mailto:${site.email}`} class="overlay-social-icon" aria-label={ui['a11y-social-email']}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </a>
    </div>
  </div>
</div>
