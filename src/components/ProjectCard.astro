---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang, type Ui } from '../i18n';
import { caseStudyHref } from '../lib/caseStudy';
import ProjectImage from './ProjectImage.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  ui: Ui;
}

const { project, lang, ui } = Astro.props;
const p = project.data;

// Só os projetos com case study têm página, e só esses mostram o botão.
const caseHref = p.caseStudy ? caseStudyHref(p.slug, lang) : null;
---

<div class="project-card reveal">
  <div class="project-thumb">
    <ProjectImage
      project={p}
      variant="card"
      lang={lang}
      alt={p.imageAlt ? t(p.imageAlt, lang) : undefined}
    />
  </div>
  <div class="project-info">
    <h3 class="project-title">{t(p.title, lang)}</h3>
    {p.tagline && <p class="project-tagline">{t(p.tagline, lang)}</p>}
    <div class="project-tech-icons">
      {p.tech.map((tech) => <span class="tech-badge">{t(tech, lang)}</span>)}
    </div>
    <button class="btn-view-more" data-modal={`modal-${p.slug}`}>
      {ui['project-btn-view-more']}
    </button>
    {
      caseHref && (
        <a class="btn-case-study" href={caseHref}>
          {ui['project-btn-case-study']}
        </a>
      )
    }
  </div>
</div>
