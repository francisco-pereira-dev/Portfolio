---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang, type Ui } from '../i18n';
import ProjectImage from './ProjectImage.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  ui: Ui;
}

const { project, lang, ui } = Astro.props;
const p = project.data;
---

<div class="project-card reveal">
  <div class="project-thumb">
    <ProjectImage project={p} variant="card" alt={t(p.imageAlt, lang)} />
  </div>
  <div class="project-info">
    <h3 class="project-title">{t(p.title, lang)}</h3>
    <div class="project-tech-icons">
      {p.tech.map((tech) => <span class="tech-badge">{t(tech, lang)}</span>)}
    </div>
    <button class="btn-view-more" data-modal={`modal-${p.slug}`}>
      {ui['project-btn-view-more']}
    </button>
  </div>
</div>
