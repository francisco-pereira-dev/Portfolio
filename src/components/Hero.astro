---
import { Image } from 'astro:assets';
import type { Ui } from '../i18n';
import site from '../data/site.json';
// A fotografia voltou ao hero na fase 4.2a, no topo, junto ao nome. Continua em
// assets/ na raiz; o Vite importa-a e o Astro otimiza-a.
import avatar from '../../assets/images/avatar.jpg';

interface Props {
  ui: Ui;
}

const { ui } = Astro.props;
---

<section id="hero" class="hero-section">
  <div class="hero-content reveal">
    {/* Acima da dobra: nunca lazy, e com prioridade de carregamento. Mostrada a
        200px (fase 4.2c); o dobro para ecrãs de alta densidade. */}
    <Image
      src={avatar}
      alt={ui['a11y-avatar-alt']}
      class="hero-avatar"
      width={Math.min(400, avatar.width)}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    {/* O ponto final a roxo é desenhado em CSS (::after), para o título ficar
        exatamente o texto do canónico. */}
    <h1 class="main-title">{ui['hero-title']}</h1>
    <p class="hero-subtitle">{ui['hero-subtitle']}</p>
    <p class="hero-paragraph">{ui['hero-paragraph']}</p>

    {/* Um só botão preenchido; os outros dois são links. */}
    <div class="hero-buttons">
      <a href="#projects" class="btn btn-primary">{ui['hero-btn-projects']}</a>
      <a href={`/${site.cvPath}`} target="_blank" rel="noopener noreferrer" download class="text-link"
        >{ui['hero-btn-cv']}</a
      >
      <a href="#contacts" class="text-link">{ui['hero-btn-contact']}</a>
    </div>
  </div>
</section>
