---
/**
 * Toda a camada de SEO e de partilha social.
 *
 * Antes disto o site não tinha nada: sem Open Graph, sem Twitter cards, sem
 * canonical, sem hreflang, sem JSON-LD, sem theme-color. Partilhar o link no
 * LinkedIn não produzia pré-visualização nenhuma.
 *
 * Sem `pagina`, produz a página inicial exatamente como antes. As páginas de
 * case study passam o seu título, descrição, caminhos e imagem.
 */
import site from '../data/site.json';
import grupos from '../data/skills.json';
import { localeHref, otherLang, type Lang, type Ui } from '../i18n';
import type { PaginaSeo } from '../lib/seo';

interface Props {
  lang: Lang;
  ui: Ui;
  pagina?: PaginaSeo;
}

const { lang, ui, pagina } = Astro.props;

const base = Astro.site ?? new URL('https://franciscopereira.dev/');
const absoluto = (caminho: string) => new URL(caminho, base).href;

const titulo = pagina?.titulo ?? ui['meta-title'];
const descricao = pagina?.descricao ?? ui['meta-description'];

// Caminho desta página e da mesma página em cada língua, para o hreflang.
const caminho = pagina?.caminho ?? localeHref[lang];
const caminhoOutra = pagina?.caminhoOutra ?? localeHref[otherLang(lang)];
const caminhoPt = lang === 'pt' ? caminho : caminhoOutra;
const caminhoEn = lang === 'en' ? caminho : caminhoOutra;

const urlPagina = absoluto(caminho);
const imagem = pagina?.imagem ?? { src: '/og-image.png', width: 1200, height: 630, alt: titulo };
const urlImagem = absoluto(imagem.src);
const tipo = pagina?.tipo ?? 'website';

// pt_PT / en_GB, conforme pedido.
const localeOg: Record<Lang, string> = { pt: 'pt_PT', en: 'en_GB' };

// As tecnologias do JSON-LD saem da mesma fonte que a secção de competências,
// para não haver duas listas a divergir.
const tecnologias = grupos.flatMap((g) => g.items.map((i) => i.name));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Full-Stack Developer',
  description: descricao,
  url: absoluto('/'),
  image: urlImagem,
  email: `mailto:${site.email}`,
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    // Fase 4.2d: o nome novo da instituição.
    name: 'Universidade de Leiria e Oeste',
  },
  knowsAbout: tecnologias,
  sameAs: [site.githubUrl, site.linkedinUrl],
  nationality: {
    '@type': 'Country',
    name: 'PT',
  },
};
---

<title>{titulo}</title>
<meta name="description" content={descricao} />

{/* Canonical e alternativas de idioma */}
<link rel="canonical" href={urlPagina} />
<link rel="alternate" hreflang="pt-PT" href={absoluto(caminhoPt)} />
<link rel="alternate" hreflang="en" href={absoluto(caminhoEn)} />
<link rel="alternate" hreflang="x-default" href={absoluto(caminhoPt)} />

{/* Open Graph */}
<meta property="og:type" content={tipo} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descricao} />
<meta property="og:url" content={urlPagina} />
<meta property="og:image" content={urlImagem} />
{imagem.width && <meta property="og:image:width" content={String(imagem.width)} />}
{imagem.height && <meta property="og:image:height" content={String(imagem.height)} />}
<meta property="og:image:alt" content={imagem.alt} />
<meta property="og:locale" content={localeOg[lang]} />
<meta property="og:locale:alternate" content={localeOg[otherLang(lang)]} />

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descricao} />
<meta name="twitter:image" content={urlImagem} />

{/* Cor da barra do browser, uma por esquema — os valores são os --bg-color reais. */}
<meta name="theme-color" content="#F8FAFC" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0F172A" media="(prefers-color-scheme: dark)" />

{/* Dados estruturados só na página inicial portuguesa, que é a canónica do site. */}
{
  lang === 'pt' && !pagina && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  )
}

